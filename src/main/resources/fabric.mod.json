  "authors": [
    "AtillaTokmak"
  ],
  "contact": {
    "homepage": "https://github.com/AtillaTokmak/PortalEscape"
  },
  "license": "MIT",
  "icon": "assets/portalescape/icon.png",
  "environment": "client",
